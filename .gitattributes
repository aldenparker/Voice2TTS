# Normalise line endings so a Windows checkout does not rewrite every file.
* text=auto eol=lf

# Windows-native tooling that must keep CRLF.
*.ps1 text eol=crlf
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Verbatim licence text: never reformat.
COPYING text eol=lf

# Binary, never diffed or line-ending converted.
*.png binary
*.ico binary
*.onnx binary
*.bin binary
*.exe binary
*.wav binary
*.zip binary
