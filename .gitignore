# Build output
build/
dist/

# Downloaded model weights: ~384 MB, and regenerated on demand by
#   python scripts/fetch_models.py --bundle
# Keeping them out of git avoids bloating the repo with binaries that already
# live on HuggingFace.
#
# Note this excludes the CONTENTS of models/, not models/ itself. Ignoring the
# directory would stop git descending into it, and the re-inclusions below would
# then be silently ineffective.
models/*

# ...except the prompt corpus. 75 KB of text, and its only source serves no
# HTTPS, so committing it keeps builds reproducible and removes an
# unauthenticated download from what ends up in the installer.
!models/prompts/
models/prompts/*
!models/prompts/arctic.txt

# Generated from voice2tts/icon.py by scripts/make_icon.py
installer/voice2tts.ico

# Spike scratch output
spike/out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.idea/
.vscode/

# Runtime
*.log
*.toml.tmp

# Windows
Thumbs.db
desktop.ini
*.lnk
